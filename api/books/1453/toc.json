"i": 391, "t": "الحادي عشر في الوقف والصدقة", "d": 1, "pg": 342}, {"i": 392, "t": "الثالث عشر في الهبة", "d": 1, "pg": 343}, {"i": 393, "t": "الرابع عشر في البيع والشراء", "d": 1, "pg": 343}, {"i": 394, "t": "الخامس عشر: في الاستبراء", "d": 1, "pg": 343}, {"i": 395, "t": "السادس عشر: في المداينات", "d": 1, "pg": 344}, {"i": 396, "t": "السابع عشر: في الإجارات", "d": 1, "pg": 345}, {"i": 397, "t": "الثامن عشر: في منع الدعوى", "d": 1, "pg": 345}, {"i": 398, "t": "التاسع عشر: في الوكالة؛", "d": 1, "pg": 346}, {"i": 399, "t": "العشرون: في الشفعة؛", "d": 1, "pg": 346}, {"i": 400, "t": "الحادي والعشرون: في الصلح", "d": 1, "pg": 346}, {"i": 401, "t": "الثاني والعشرون: في الكفالة", "d": 1, "pg": 346}, {"i": 402, "t": "الثالث والعشرون: في الحوالة", "d": 1, "pg": 346}, {"i": 403, "t": "الرابع والعشرون: في الرهن", "d": 1, "pg": 346}, {"i": 404, "t": "الخامس والعشرون: في الوصايا", "d": 1, "pg": 346}, {"i": 405, "t": "الفن السادس: الفروق", "d": 0, "pg": 348}, {"i": 406, "t": "كتاب الصلاة وفيها بعض مسائل الطهارة", "d": 1, "pg": 348}, {"i": 407, "t": "كتاب الزكاة", "d": 1, "pg": 349}, {"i": 408, "t": "كتاب الصوم", "d": 1, "pg": 349}, {"i": 409, "t": "كتاب الحج", "d": 1, "pg": 350}, {"i": 410, "t": "كتاب النكاح", "d": 1, "pg": 350}, {"i": 411, "t": "كتاب الطلاق", "d": 1, "pg": 350}, {"i": 412, "t": "كتاب العتاق", "d": 1, "pg": 351}, {"i": 413, "t": "الفن السابع: الحكايات والمراسلات", "d": 0, "pg": 352}, {"i": 414, "t": "فسأله أبو حنيفة عن خمس مسائل", "d": 1, "pg": 352}, {"i": 415, "t": "العقود، متى يملك المالك بها، معها، أو بعدها،", "d": 1, "pg": 353}, {"i": 416, "t": "خدعتني امرأة وفقهتني امرأة وزهدتني امرأة", "d": 1, "pg": 353}, {"i": 417, "t": "عمن قال: لا أرجو الجنة، ولا أخاف النار،", "d": 1, "pg": 354}, {"i": 418, "t": "عمن يقول: أنا لا أخاف النار ولا أرجو الجنة،", "d": 1, "pg": 354}, {"i": 419, "t": ": سلوني عن الفقه فقال الإمام: ما تقول في امرأة المفقود؟", "d": 1, "pg": 354}, {"i": 420, "t": "قال الإمام: خرجنا مع حماد نشيع الأعمش", "d": 1, "pg": 354}, {"i": 421, "t": "وخرج الإمام إلى بستان فلما رجع مع أصحابه إذ هو بابن أبي ليلى", "d": 1, "pg": 354}, {"i": 422, "t": "وكان أبو حنيفة رحمه الله تعالى في وليمة في الكوفة وفيها العلماء", "d": 1, "pg": 355}, {"i": 423, "t": "فقال له: أسائل أنت؟ قال: نعم قال: انزل؛ مكانك الأرض ومكاني المنبر", "d": 1, "pg": 355}, {"i": 424, "t": "احتاج الإمام إلى الماء في طريق الحاج", "d": 1, "pg": 355}, {"i": 425, "t": "وصية الإمام الأعظم لأبي يوسف رحمه الله", "d": 1, "pg": 355}]}