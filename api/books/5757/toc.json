قول بأن ملك اليمين أقوى من ملك النكاح", "d": 1, "pg": 1151}, {"i": 427, "t": "لا تقبل شهادة الشهود على القاضي", "d": 1, "pg": 1151}, {"i": 428, "t": "لا يقبض من نفسه لغيره", "d": 1, "pg": 1151}, {"i": 429, "t": "لا تقوم الكلاب إلا في مسألة الوصية", "d": 1, "pg": 1151}, {"i": 430, "t": "لا ينكر إلا ما أجمع على منعه", "d": 1, "pg": 1151}, {"i": 431, "t": "لا يؤمر بضم الأصابع في شيء من سنن الصلاة", "d": 1, "pg": 1152}, {"i": 432, "t": "لا يشتغل المأموم بفعل ما تركه الإمام", "d": 1, "pg": 1153}, {"i": 433, "t": "ليس شيء من الأيمان يتعدد في جانب المدعي ابتداء", "d": 1, "pg": 1153}, {"i": 434, "t": "ليس للقاضي أن يقبض ما في الذمة لمالكه بسؤال المديون", "d": 1, "pg": 1153}, {"i": 435, "t": "ليس لنا نجس يزال بغير الماء", "d": 1, "pg": 1154}, {"i": 436, "t": "ليس لنا نجس مائع تجب إراقته إلا الخمرة", "d": 1, "pg": 1154}, {"i": 437, "t": "ليس لنا صلاة يفصل فيها بين دعاء الاستفتاح والتعوذ بشيء غير صلاة العيد", "d": 1, "pg": 1155}, {"i": 438, "t": "ليس لنا من تقدم على الإمام بركن", "d": 1, "pg": 1155}, {"i": 439, "t": "ليس لنا مكلف حر مقيم تلزمه الجمعة", "d": 1, "pg": 1155}, {"i": 440, "t": "حرف الياء", "d": 0, "pg": 1156}, {"i": 441, "t": "اليتيم", "d": 1, "pg": 1156}, {"i": 442, "t": "طلب ما يحزم على المطلوب منه فعله", "d": 1, "pg": 1156}, {"i": 443, "t": "يدخل القوي على الضعيف دون العكس", "d": 1, "pg": 1157}, {"i": 444, "t": "اليد قسمان", "d": 1, "pg": 1157}, {"i": 445, "t": "اليد اللاحقة تابعة لليد السابقة", "d": 1, "pg": 1160}, {"i": 446, "t": "يغتفر في الابتداء ما لا يغتفر في الدوام", "d": 1, "pg": 1160}, {"i": 447, "t": "يغتفر في الدوام ما لا يغتفر في الابتداء", "d": 1, "pg": 1162}, {"i": 448, "t": "ما لا يغتفر فيهما أي الابتداء والدوام", "d": 1, "pg": 1163}, {"i": 449, "t": "يغتفر في الشيء إذا كان تابعا ما لا يغتفر إذا كان مقصودا", "d": 1, "pg": 1164}, {"i": 450, "t": "يغتفر في المعاملة مع العاقد ما لا يغتفر مع غيره", "d": 1, "pg": 1165}, {"i": 451, "t": "يغتفر في معاملة الكفار ما لا يغتفر في غيرها", "d": 1, "pg": 1166}, {"i": 452, "t": "يغتفر في الفسوخ ما لا يغتفر في ابتداء العقود", "d": 1, "pg": 1167}, {"i": 453, "t": "يغتفر عند الانفراد ما لا يغتفر عند الاجتماع", "d": 1, "pg": 1167}, {"i": 454, "t": "اليقين شرط في الإقرار", "d": 1, "pg": 1168}, {"i": 455, "t": "اليمين فيها مباحث", "d": 1, "pg": 1168}, {"i": 456, "t": "قواعد يختم بها", "d": 0, "pg": 1180}, {"i": 457, "t": "ما أوجبه الله تعالى على المكلفين", "d": 1, "pg": 1180}, {"i": 458, "t": "من ملك شيئا له أن يخرجه عن ملكه", "d": 1, "pg": 1181}, {"i": 459, "t": "اتباع خير الخيرين واجتناب شر الشرين", "d": 1, "pg": 1183}, {"i": 460, "t": "حديث النفس الوارد من غير استقرار", "d": 1, "pg": 1184}, {"i": 461, "t": "الأخذ بالرخص والعزائم في محلها", "d": 1, "pg": 1184}, {"i": 462, "t": "الشريعة قسمان مأمورات ومنهيات", "d": 1, "pg": 1185}, {"i": 463, "t": "المطارحات", "d": 1, "pg": 1186}, {"i": 464, "t": "الممتحنات", "d": 1, "pg": 1187}, {"i": 465, "t": "المغالطات", "d": 1, "pg": 1191}, {"i": 466, "t": "نكتة جدلية", "d": 1, "pg": 1193}]}