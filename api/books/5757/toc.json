: "من ملك التنجيز ملك التعليق", "d": 1, "pg": 999}, {"i": 367, "t": "من لا يملك التنجيز لا يملك التعليق", "d": 1, "pg": 999}, {"i": 368, "t": "المعلق لا ينجز", "d": 1, "pg": 1004}, {"i": 369, "t": "من ملك الكل ملك البعض", "d": 1, "pg": 1005}, {"i": 370, "t": "من ملك بعضه عتق عليه", "d": 1, "pg": 1005}, {"i": 371, "t": "من علم حرمة شيء مما يجب فيه الحد وجهل وجوب الحد", "d": 1, "pg": 1006}, {"i": 372, "t": "من كان القول قوله في أصل الشيء", "d": 1, "pg": 1007}, {"i": 373, "t": "من وجب عليه رد عين هل تكون مئونة الرد عليه", "d": 1, "pg": 1008}, {"i": 374, "t": "المال حقيقته", "d": 1, "pg": 1010}, {"i": 375, "t": "الملك يتعلق به مباحث", "d": 1, "pg": 1011}, {"i": 376, "t": "الموالاة في الوضوء والغسل والتيمم", "d": 1, "pg": 1029}, {"i": 377, "t": "حرف النون", "d": 0, "pg": 1031}, {"i": 378, "t": "النادر هل يلحق بالغالب", "d": 1, "pg": 1031}, {"i": 379, "t": "النادر إذا لم يدم", "d": 1, "pg": 1032}, {"i": 380, "t": "النادر إذا دام", "d": 1, "pg": 1032}, {"i": 381, "t": "النادر هل يعتبر بنفسه أم يلحق بجنسه", "d": 1, "pg": 1034}, {"i": 382, "t": "النائم يعطى حكم المستيقظ في صور", "d": 1, "pg": 1034}, {"i": 383, "t": "النجاسة يتعلق بها مباحث", "d": 1, "pg": 1036}, {"i": 384, "t": "النذر المطلق", "d": 1, "pg": 1058}, {"i": 385, "t": "النسيان عذر في المنهيات دون المأمورات", "d": 1, "pg": 1060}, {"i": 386, "t": "النظر إلى الظاهر أو إلى ما في نفس الأمر", "d": 1, "pg": 1063}, {"i": 387, "t": "النفل فيه مباحث", "d": 1, "pg": 1064}, {"i": 388, "t": "النقد", "d": 1, "pg": 1067}, {"i": 389, "t": "النكرة إذا أعيدت كانت غير الأولى", "d": 1, "pg": 1069}, {"i": 390, "t": "النكول مع اليمين المردودة", "d": 1, "pg": 1071}, {"i": 391, "t": "النية يتعلق بها مباحث", "d": 1, "pg": 1072}, {"i": 392, "t": "النيابة في العبادات", "d": 1, "pg": 1100}, {"i": 393, "t": "النهي إن رجع إلى شرط أو ركن", "d": 1, "pg": 1101}, {"i": 394, "t": "حرف الهاء", "d": 0, "pg": 1103}, {"i": 395, "t": "الهواء في الأرض والبناء تابع لأصله", "d": 1, "pg": 1103}, {"i": 396, "t": "حرف الواو", "d": 0, "pg": 1104}, {"i": 397, 